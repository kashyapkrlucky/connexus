# ── Database (Neon Postgres) ──────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ── Auth.js (Google sign-in) ──────────────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Google Cloud Console → Credentials → OAuth client.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Supabase Storage (post & community images) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Server-only key for uploads; falls back to the publishable key if unset.
SUPABASE_SECRET_KEY=""

# ── Community bot ─────────────────────────────────────────────────────────
# Optional: without it the bot posts the newest item verbatim instead of an AI summary.
OPENAI_API_KEY=""
# Optional model override (default: gpt-5.4-mini).
BOT_MODEL=""

# ── Trigger.dev (background jobs) ─────────────────────────────────────────
# Only needed to trigger tasks from code; `npm run jobs:dev` uses your CLI login.
TRIGGER_SECRET_KEY=""
